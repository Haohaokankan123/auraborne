{
  "name": "mario-kart-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original Mario Kart-style 3D browser racing game (Three.js + Socket.IO). All assets CC0/MIT, no Nintendo IP.",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n vite,server -c cyan,magenta \"vite\" \"node server/index.js\"",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "concurrently": "^10.0.3",
    "stats.js": "^0.17.0",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16"
  }
}
